{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vulcan/manifest.schema.json",
  "title": "VULCAN render manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "fps", "aspect", "audio", "beats", "assets"],
  "properties": {
    "video_id": { "type": "string", "pattern": "^v_[A-Za-z0-9_-]{4,64}$" },
    "fps": { "const": 30 },
    "aspect": { "const": "9:16" },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "duration_ms"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": { "$ref": "#/$defs/beat" }
    },
    "assets": {
      "type": "array",
      "maxItems": 60,
      "items": { "$ref": "#/$defs/asset" }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mood", "file"],
      "properties": {
        "mood": { "enum": ["energetic", "chill", "dramatic", "uplifting", "tech", "none"] },
        "file": { "type": ["string", "null"] }
      }
    },
    "post_kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook", "caption", "hashtags"],
      "properties": {
        "hook": { "type": "string", "minLength": 1, "maxLength": 120 },
        "caption": { "type": "string", "minLength": 1, "maxLength": 2200 },
        "hashtags": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "pattern": "^#[A-Za-z0-9_]{2,30}$" }
        }
      }
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_ms", "end_ms", "words", "treatment", "text_overlay", "assets", "sfx", "camera", "transition_out"],
      "properties": {
        "id": { "type": "string", "pattern": "^b[0-9]{2,3}$" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["w", "s", "e"],
            "properties": {
              "w": { "type": "string", "minLength": 1 },
              "s": { "type": "integer", "minimum": 0 },
              "e": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "treatment": {
          "enum": ["kinetic_type", "cutout_pop", "stat_slam", "list_stack", "tweet_card", "screenshot_zoom", "logo_versus", "emoji_burst", "quote_card"]
        },
        "text_overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["karaoke", "headline"] },
            "emphasis_words": {
              "type": "array",
              "maxItems": 4,
              "items": { "type": "string", "minLength": 1 }
            },
            "headline_text": { "type": "string", "minLength": 1, "maxLength": 60 }
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_id", "role", "enter_ms", "exit_ms"],
            "properties": {
              "asset_id": { "type": "string", "pattern": "^a[0-9]{2,3}$" },
              "role": { "enum": ["hero", "secondary", "background", "left", "right"] },
              "enter_ms": { "type": "integer", "minimum": 0, "description": "relative to beat start" },
              "exit_ms": { "type": "integer", "minimum": 0, "description": "relative to beat start" }
            }
          }
        },
        "sfx": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cue", "at_ms"],
            "properties": {
              "cue": { "type": "string", "minLength": 1 },
              "at_ms": { "type": "integer", "minimum": 0, "description": "relative to beat start" }
            }
          }
        },
        "camera": { "enum": ["static", "punch_in", "drift"] },
        "transition_out": { "enum": ["hard_cut", "whip", "flash"] },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stat_text": { "type": "string", "minLength": 1, "maxLength": 12 },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "at_ms"],
                "properties": {
                  "text": { "type": "string", "minLength": 1, "maxLength": 28 },
                  "at_ms": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "tweet": {
              "type": "object",
              "additionalProperties": false,
              "required": ["author", "handle", "text"],
              "properties": {
                "author": { "type": "string", "minLength": 1, "maxLength": 40 },
                "handle": { "type": "string", "pattern": "^@[A-Za-z0-9_]{1,20}$" },
                "text": { "type": "string", "minLength": 1, "maxLength": 220 }
              }
            },
            "quote": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "attribution"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 160 },
                "attribution": { "type": "string", "minLength": 1, "maxLength": 40 }
              }
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "type", "queries", "path", "status", "score"],
      "properties": {
        "asset_id": { "type": "string", "pattern": "^a[0-9]{2,3}$" },
        "type": { "enum": ["photo_cutout", "3d_icon", "flat_icon", "logo", "lottie", "emoji", "screenshot"] },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "path": { "type": ["string", "null"] },
        "status": { "enum": ["pending", "fetched", "validated", "failed"] },
        "score": { "type": ["number", "null"] }
      }
    }
  }
}
